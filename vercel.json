{
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "(www\\.)?qwebbo\\.eu" }], "destination": "https://qwebbo.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www\\.qwebbo\\.com" }], "destination": "https://qwebbo.com/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
